# Required for forecasts
OPENWEATHER_API_KEY=

# GeoNames (free registration: http://www.geonames.org/login)
GEONAMES_USERNAME=demo

# Climatology: Meteostat Python library (pip: meteostat) uses bulk data — no key.
# Optional: normals period (defaults 1991–2020, aligned with WMO / ERA5 fallback)
# METEOSTAT_NORMALS_START_YEAR=1991
# METEOSTAT_NORMALS_END_YEAR=2020

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Optional: Copernicus CDS for true ERA5 retrieval (advanced)
CDS_URL=https://cds.climate.copernicus.eu/api
CDS_KEY=

# Cache directory for context and LLM outputs
CACHE_DIR=.cache
